{
  "name": "baseline-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Acceptance testing for any web app, inside Claude Code.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fast": "vitest run --exclude \"test/{guard,runner-script,signin,fixture-app,host}.spec.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && node scripts/build.mjs --verify && vitest run && (command -v claude >/dev/null && claude plugin test || echo \"WARNING: claude CLI not found, mod tests skipped\" >&2)",
    "fixture": "tsx test/fixture-app/run.ts",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:mod": "claude plugin test",
    "screenshots": "node scripts/build.mjs && node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
